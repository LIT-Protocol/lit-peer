//! Deploy contracts from a folder of ABI JSON artifacts to a local Anvil chain.
//!
//! Usage: deploy <abis_folder>
//!
//! Expects Anvil at http://127.0.0.1:8545 and uses the default Anvil account #0 for deployment.

use ethers::contract::ContractFactory;
use ethers::prelude::*;
use std::env;
use std::fs;
use std::path::Path;

const ANVIL_RPC: &str = "http://127.0.0.1:8545";
/// Default Anvil account #0 private key (well-known for local dev)
const ANVIL_DEFAULT_KEY: &str = "0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80";

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let args: Vec<String> = env::args().collect();
    if args.len() < 2 {
        eprintln!("Usage: {} <abis_folder>", args.get(0).unwrap_or(&"deploy".into()));
        eprintln!("  abis_folder - folder containing contract artifact JSON files (abi + bytecode)");
        eprintln!("  Connects to Anvil at {} and deploys each contract.", ANVIL_RPC);
        std::process::exit(1);
    }
    let abis_folder = args[1].trim_end_matches('/');

    let provider = Provider::<Http>::try_from(ANVIL_RPC)?;
    let chain_id = provider.get_chainid().await?;
    let wallet: LocalWallet = ANVIL_DEFAULT_KEY.parse::<LocalWallet>()?.with_chain_id(chain_id.as_u64());
    let client = SignerMiddleware::new(provider, wallet);
    let client = std::sync::Arc::new(client);

    let dir = fs::read_dir(abis_folder)?;
    for entry in dir.flatten() {
        let path = entry.path();
        if path.extension().map(|e| e == "json").unwrap_or(false) {
            if let Err(e) = deploy_artifact(&path, client.clone()) {
                eprintln!("Failed to deploy {:?}: {}", path.file_name().unwrap(), e);
            }
        }
    }

    Ok(())
}

/// Read ABI and bytecode from a Hardhat/Foundry-style artifact JSON and deploy to the connected chain.
fn deploy_artifact(
    path: &Path,
    client: std::sync::Arc<SignerMiddleware<Provider<Http>, LocalWallet>>,
) -> Result<(), Box<dyn std::error::Error>> {
    let name = path
        .file_stem()
        .and_then(|s| s.to_str())
        .unwrap_or("unknown");
    let contents = fs::read_to_string(path)?;
    let artifact: serde_json::Value = serde_json::from_str(&contents)?;

    let abi_value = artifact
        .get("abi")
        .ok_or("artifact missing 'abi'")?;
    let abi = ethers::abi::Abi::load(abi_value.to_string().as_bytes())?;

    let bytecode_hex = artifact
        .get("bytecode")
        .and_then(|v| v.as_str())
        .or_else(|| {
            artifact
                .get("evm")
                .and_then(|evm| evm.get("bytecode"))
                .and_then(|bc| bc.get("object"))
                .and_then(|o| o.as_str())
        })
        .ok_or("artifact missing 'bytecode' and evm.bytecode.object")?;

    if bytecode_hex.is_empty() || bytecode_hex == "0x" {
        println!("Skipping {} (no bytecode)", name);
        return Ok(());
    }

    let bytecode = Bytes::from_hex(bytecode_hex)?;
    let factory = ContractFactory::new(abi, bytecode, client);
    let deployer = factory.deploy(())?.legacy();
    let (contract, _receipt) = deployer.send_with_receipt().await?;
    println!("Deployed {} -> {:?}", name, contract.address());
    Ok(())
}
